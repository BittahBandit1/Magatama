+#ifdef __ANDROID__
+// RRV Android present pacing. Android screens often run at 120 Hz, where FIFO alone shows 59.94 FPS frames for 1 and
+// 3 refreshes alternately (measured on a Retroid Pocket Nova: of 125 frames only 9-27 got the 2 refreshes each should
+// get). VK_GOOGLE_display_timing (implemented by Android's Vulkan loader) lets each present carry the earliest time it
+// may be shown: the targets advance by a whole number of refresh cycles per frame (2 at 120 Hz, 1 at 60 Hz), locked to
+// real vsync times reported back by vkGetPastPresentationTimingGOOGLE. A frame that arrives too late for its target
+// re-anchors on the next reachable vsync (one longer frame instead of a run of uneven ones).
+// RRV_PCSX2_GS_PRESENT_PACING=0 turns it off; every ~2 s the log gets the measured on-screen frame lengths.
+// On-screen frame lengths as the display reported them (actualPresentTime deltas, ms), newest at
+// g_rrv_display_frames - 1: the bridge's performance overlay draws these, not the host's present calls.
+std::atomic<u64> g_rrv_display_frames{0};
+float g_rrv_display_ms[128];
+static u64 RrvMonotonicNs()
+{
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return static_cast<u64>(ts.tv_sec) * 1000000000ull + static_cast<u64>(ts.tv_nsec);
+}
