+	// RRV Magatama: whole-frame feedback at the PS2's own resolution. Nocturne's
+	// encounter transition (and similar smears) draws the previous frame over the
+	// current one each field as one full-screen FST sprite, sampled bilinearly half a
+	// pixel off (XY = UV - (0.5, 0.3125)), blended by FIX (A=Cs B=Cd C=FIX D=Cd):
+	// the 2-tap average, fed back field after field, is the smear. At scale N the
+	// half native pixel is N/2 host texels and the average mostly vanishes (3x:
+	// a faint double image, 2026-11-17). Such a draw is made at scale 1 from a
+	// box-downsampled native copy of its source (the texture cache rescales the
+	// frame for it, as for PCSX2's native scaling): the smear the PS2 makes. Only a smear (FIX >= 96: the transition draws 120); the light ghost trail a summon draws over the battle and its HUD (FIX 54-56) stays at full scale, or every field would come out at native resolution.
+	if (src && src->m_from_target && src->m_from_target->GetScale() > 1.0f && target_scale > 1.0f &&
+		m_vertex->next == 2 && m_vt.m_primclass == GS_SPRITE_CLASS && PRIM->TME && PRIM->FST && PRIM->ABE &&
+		m_vt.IsRealLinear() && !m_texture_shuffle && !m_channel_shuffle &&
+		m_context->ALPHA.A == 0 && m_context->ALPHA.B == 1 && m_context->ALPHA.C == 2 && m_context->ALPHA.D == 1 && m_context->ALPHA.FIX >= 96 &&
+		m_cached_ctx.TEX0.TBW == m_cached_ctx.FRAME.FBW && m_cached_ctx.TEX0.TBP0 != m_cached_ctx.FRAME.Block() &&
+		(m_cached_ctx.TEX0.PSM & ~0x1) == (PSMCT32 & ~0x1) && (m_cached_ctx.FRAME.PSM & ~0x1) == (PSMCT32 & ~0x1))
+	{
+		const GSVertex* v = &m_vertex->buff[0];
+		const int ox = m_context->XYOFFSET.OFX, oy = m_context->XYOFFSET.OFY;
+		const int du = static_cast<int>(v[0].U) - (static_cast<int>(v[0].XYZ.X) - ox);
+		const int dv = static_cast<int>(v[0].V) - (static_cast<int>(v[0].XYZ.Y) - oy);
+		const int w = (static_cast<int>(v[1].XYZ.X) - static_cast<int>(v[0].XYZ.X)) >> 4;
+		const int h = (static_cast<int>(v[1].XYZ.Y) - static_cast<int>(v[0].XYZ.Y)) >> 4;
+		const int tw = (static_cast<int>(v[1].U) - static_cast<int>(v[0].U)) >> 4;
+		const int th = (static_cast<int>(v[1].V) - static_cast<int>(v[0].V)) >> 4;
+		if ((du != 0 || dv != 0) && std::abs(du) <= 16 && std::abs(dv) <= 16 && w >= 256 && h >= 192 &&
+			std::abs(w - tw) <= 1 && std::abs(h - th) <= 1)
+		{
+			target_scale = 1.0f;
+			m_downscale_source = true;
+			s_rrv_native_feedback_draws.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
