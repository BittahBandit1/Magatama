+bool GSDeviceVK::RrvAndroidPacePresent(VkSwapchainKHR swap_chain, VkPresentTimeGOOGLE& time)
+{
+	struct State
+	{
+		VkSwapchainKHR swap_chain = VK_NULL_HANDLE;
+		u64 refresh = 0;      // ns per display refresh
+		u32 cycles = 0;       // refreshes per frame (0: pacing off for this display)
