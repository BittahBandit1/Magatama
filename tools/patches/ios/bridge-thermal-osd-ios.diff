 // Runs the host overlay, if one is registered, inside the open ImGui frame.
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+// iOS: the device's thermal state (and Low Power Mode) in the top-left corner, beside the Metal HUD. The app
+// (src/app/magatama_ios.mm) exports magatama_ios_thermal_state(): 0 nominal .. 3 critical, +16 with Low Power Mode.
+// MAGATAMA_THERMAL_OSD=0 hides it.
+void DrawThermalOsd()
+{
+    static int (*state_fn)() = nullptr;
+    static bool resolved = false, enabled = true;
+    if (!resolved)
+    {
+        resolved = true;
+        state_fn = reinterpret_cast<int (*)()>(dlsym(RTLD_DEFAULT, "magatama_ios_thermal_state"));
+        const char* env = std::getenv("MAGATAMA_THERMAL_OSD");
+        enabled = !(env && std::strcmp(env, "0") == 0);
+    }
+    if (!state_fn || !enabled)
+        return;
+    const int raw = state_fn();
+    const int state = std::clamp(raw & 15, 0, 3);
+    static const char* const names[] = {"Nominal", "Fair", "Serious", "Critical"};
+    static const ImU32 colors[] = {IM_COL32(110, 230, 120, 255), IM_COL32(240, 220, 90, 255),
+                                   IM_COL32(255, 150, 60, 255), IM_COL32(255, 80, 80, 255)};
+    char text[64];
+    std::snprintf(text, sizeof text, "Thermal: %s%s", names[state], (raw & 16) ? "  Low Power" : "");
+    const float scale = OverlayScale();
+    ImFont* font = ImGuiManager::GetStandardFont();
+    const float size = std::ceil(13.0f * scale);
+    const ImVec2 extent = font->CalcTextSizeA(size, FLT_MAX, 0.0f, text);
+    const float pad = 4.0f * scale;
+    const ImVec2 at(10.0f * scale, 10.0f * scale);
+    ImDrawList* draw = ImGui::GetForegroundDrawList();
+    draw->AddRectFilled(at, ImVec2(at.x + extent.x + 2 * pad, at.y + extent.y + 2 * pad), IM_COL32(0, 0, 0, 150),
+                        3.0f * scale);
+    draw->AddText(font, size, ImVec2(at.x + pad, at.y + pad), (raw & 16) ? colors[3] : colors[state], text);
+}
+#endif
+
 // Direct presentation only: the snapshot path presents nothing.
 void RunHostOverlay()
 {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    if (ImGui::GetCurrentContext())
+        DrawThermalOsd();
+#endif
     if (!s_overlay_registered.load(std::memory_order_acquire))
         return;
     std::lock_guard<std::mutex> lock(s_overlay_mutex);
