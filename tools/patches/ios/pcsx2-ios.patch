diff --git a/common/CocoaToolsIOS.mm b/common/CocoaToolsIOS.mm
new file mode 100644
index 0000000..bb5fb98
--- /dev/null
+++ b/common/CocoaToolsIOS.mm
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+// RRV iOS bridge: the CocoaTools helpers PCSX2's GS needs, over Foundation/UIKit. The host supplies the
+// CAMetalLayer (WindowInfo::surface_handle); no windows, menus, Finder or trash exist here.
+
+#if ! __has_feature(objc_arc)
+	#error "Compile this with -fobjc-arc"
+#endif
+
+#include "CocoaTools.h"
+#include "HostSys.h"
+#include "WindowInfo.h"
+#include <Foundation/Foundation.h>
+#include <UIKit/UIKit.h>
+#include <libkern/OSCacheControl.h>
+
+// The iOS toolchain has no compiler-rt __clear_cache; nothing generates code at run time here, but the
+// common code that would flush the instruction cache still links against it.
+extern "C" void __clear_cache(void* begin, void* end)
+{
+	sys_icache_invalidate(begin, static_cast<size_t>(static_cast<char*>(end) - static_cast<char*>(begin)));
+}
+
+bool CocoaTools::CreateMetalLayer(WindowInfo* wi) { return wi && wi->surface_handle; }
+void CocoaTools::DestroyMetalLayer(WindowInfo*) {}
+
+std::optional<float> CocoaTools::GetViewRefreshRate(const WindowInfo&)
+{
+	__block NSInteger fps = 60;
+	if ([NSThread isMainThread])
+		fps = [UIScreen mainScreen].maximumFramesPerSecond;
+	else
+		dispatch_sync(dispatch_get_main_queue(), ^{ fps = [UIScreen mainScreen].maximumFramesPerSecond; });
+	return fps > 0 ? std::optional<float>(static_cast<float>(fps)) : std::nullopt;
+}
+
+void CocoaTools::MarkHelpMenu(void*) {}
+
+bool Common::PlaySoundAsync(const char*) { return false; }
+
+std::optional<std::string> CocoaTools::GetBundlePath()
+{
+	@autoreleasepool {
+		NSString* path = [[NSBundle mainBundle] bundlePath];
+		if (path)
+			return std::string([path fileSystemRepresentation]);
+	}
+	return std::nullopt;
+}
+
+std::optional<std::string> CocoaTools::GetNonTranslocatedBundlePath() { return GetBundlePath(); }
+std::optional<std::string> CocoaTools::MoveToTrash(std::string_view) { return std::nullopt; }
+bool CocoaTools::DelayedLaunch(std::string_view) { return false; }
+bool CocoaTools::ShowInFinder(std::string_view) { return false; }
+
+std::optional<std::string> CocoaTools::GetResourcePath()
+{
+	@autoreleasepool {
+		NSString* path = [[NSBundle mainBundle] resourcePath];
+		if (path)
+			return std::string([path fileSystemRepresentation]);
+	}
+	return std::nullopt;
+}
+
+void* CocoaTools::CreateWindow(std::string_view, uint32_t, uint32_t) { return nullptr; }
+void CocoaTools::DestroyWindow(void*) {}
+void CocoaTools::GetWindowInfoFromWindow(WindowInfo* wi, void*) { if (wi) *wi = WindowInfo(); }
+void CocoaTools::RunCocoaEventLoop(bool) {}
+void CocoaTools::StopMainThreadEventLoop() {}
