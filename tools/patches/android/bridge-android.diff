 // Runs the host overlay, if one is registered, inside the open ImGui frame.
+// Performance overlay (RRV_PCSX2_GS_PERF_OSD=1; the Android launcher turns it on, like the Metal HUD on Apple):
+// presents per second, frame time (average and worst over the last half second), the game's own frame rate when
+// PCSX2 can tell it, GPU time per frame, and a graph of the last 120 frame times. Drawn on top of the picture
+// and the menu, top-left. Its clock is the host present cadence: this runs once per presented field.
+void DrawPerfOsd()
+{
+    static const bool enabled = [] {
+        const char* value = std::getenv("RRV_PCSX2_GS_PERF_OSD");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (!enabled || !ImGui::GetCurrentContext())
+        return;
+    using Clock = std::chrono::steady_clock;
+    constexpr int kHistory = 120;
+    static float history[kHistory] = {};
+    static int head = 0;
+    static Clock::time_point last{}, window_start{};
+    static int window_frames = 0;
+    static float window_max = 0.0f, window_sum = 0.0f;
+    static float fps = 0.0f, avg_ms = 0.0f, max_ms = 0.0f;
+    const Clock::time_point now = Clock::now();
+    if (last != Clock::time_point{})
+    {
+        const float ms = std::chrono::duration<float, std::milli>(now - last).count();
+        history[head] = ms;
+        head = (head + 1) % kHistory;
+        window_sum += ms;
+        window_max = std::max(window_max, ms);
+        ++window_frames;
+    }
+    else
+        window_start = now;
+    last = now;
+    const float window_s = std::chrono::duration<float>(now - window_start).count();
+    if (window_s >= 0.5f && window_frames > 0)
+    {
+        fps = window_frames / window_s;
+        avg_ms = window_sum / window_frames;
+        max_ms = window_max;
+        window_start = now;
+        window_frames = 0;
+        window_sum = window_max = 0.0f;
+    }
+    char line1[96], line2[96];
+    std::snprintf(line1, sizeof line1, "%.1f FPS  %.1f ms (max %.1f)", fps, avg_ms, max_ms);
+    const float game_fps = PerformanceMetrics::GetInternalFPS();
+    const float gpu_ms = PerformanceMetrics::GetGPUAverageTime();
+    if (game_fps > 0.0f)
+        std::snprintf(line2, sizeof line2, "Game %.1f FPS  GPU %.1f ms", game_fps, gpu_ms);
+    else
+        std::snprintf(line2, sizeof line2, "GPU %.1f ms", gpu_ms);
+
+    const float scale = OverlayScale();
+    ImFont* font = ImGuiManager::GetStandardFont();
+    const float size = std::ceil(13.0f * scale);
+    const float pad = 5.0f * scale;
+    const ImVec2 t1 = font->CalcTextSizeA(size, FLT_MAX, 0.0f, line1);
+    const ImVec2 t2 = font->CalcTextSizeA(size, FLT_MAX, 0.0f, line2);
+    const float graph_w = std::max(std::max(t1.x, t2.x), 150.0f * scale), graph_h = 34.0f * scale;
+    const ImVec2 at(10.0f * scale, 10.0f * scale);
+    const ImVec2 end(at.x + graph_w + 2 * pad, at.y + t1.y + t2.y + graph_h + 4 * pad);
+    ImDrawList* draw = ImGui::GetForegroundDrawList();
+    draw->AddRectFilled(at, end, IM_COL32(0, 0, 0, 160), 4.0f * scale);
+    const ImU32 text = max_ms > 34.0f ? IM_COL32(255, 120, 90, 255) : IM_COL32(120, 235, 130, 255);
+    draw->AddText(font, size, ImVec2(at.x + pad, at.y + pad), text, line1);
+    draw->AddText(font, size, ImVec2(at.x + pad, at.y + pad * 2 + t1.y), IM_COL32(220, 220, 220, 255), line2);
+    // Frame-time graph: 0 at the bottom; the scale fits 33.3 ms (a 30 FPS frame) or the worst sample, whichever is
+    // larger, with a faint line at 16.7 ms.
+    const ImVec2 g0(at.x + pad, at.y + t1.y + t2.y + pad * 3);
+    float top = 33.4f;
+    for (float v : history)
+        top = std::max(top, v);
+    const float y60 = g0.y + graph_h * (1.0f - 16.7f / top);
+    draw->AddLine(ImVec2(g0.x, y60), ImVec2(g0.x + graph_w, y60), IM_COL32(255, 255, 255, 50));
+    ImVec2 points[kHistory];
+    for (int i = 0; i < kHistory; ++i)
+    {
+        const float v = history[(head + i) % kHistory];
+        points[i] = ImVec2(g0.x + graph_w * i / (kHistory - 1), g0.y + graph_h * (1.0f - std::min(v, top) / top));
+    }
+    draw->AddPolyline(points, kHistory, IM_COL32(255, 210, 90, 255), 1.5f * scale);
+}
+
