# Recompiler configuration for Magatama: Shin Megami Tensei: Nocturne (USA, SLUS_209.11).
# A template: scripts/magatama_generate.py fills in @ELF@ (your own ELF), @OUTPUT@ and @FUNCTIONS@
# (config/magatama/nocturne-functions.csv) and runs ps2_recomp on it. Addresses, sizes and names only: no game code.
# Magatama: Shin Megami Tensei: Nocturne (USA, SLUS_209.11)
# Function boundaries: Ghidra export (Nocturne-functions-fukami.csv, with delay-slot and range fixes).
# Library stubs, MMIO and jump tables: Fukami's ps2_analyzer (Nocturne-analyzer.toml).
# Left out on purpose: the analyzer's [patches] (it would NOP ordinary sw stores at 0x2ba80c/844/874)
# and the Ghidra kernel-call stub list (Fukami runs those wrappers through instruction-driven syscalls).

[general]
input = "@ELF@"
output = "@OUTPUT@"
ghidra_output = "@FUNCTIONS@"
single_file_output = false
patch_syscalls = false
patch_cop0 = true
patch_cache = true
