+				static_cast<unsigned long long>(st.hist[1]), static_cast<unsigned long long>(st.hist[2]),
+				static_cast<unsigned long long>(st.hist[3]), static_cast<unsigned long long>(st.hist[4]),
+				static_cast<unsigned long long>(st.late), static_cast<unsigned long long>(st.reanchors));
+		st.log_at = now + 2000000000ull;
+		st.presents = st.late = st.reanchors = 0;
+		std::fill(std::begin(st.hist), std::end(st.hist), 0);
+	}
+	return true;
