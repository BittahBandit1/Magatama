+	// RRV_PCSX2_GS_PRESENT_LEAD_MS raises the floor (more slack for a late present, more latency).
+	static const u64 lead_floor = [] {
+		const char* value = std::getenv("RRV_PCSX2_GS_PRESENT_LEAD_MS");
+		const long ms = value ? std::strtol(value, nullptr, 10) : 0;
+		return (ms >= 8 && ms <= 50 ? static_cast<u64>(ms) : 12ull) * 1000000ull;
