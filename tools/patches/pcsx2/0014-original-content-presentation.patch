diff --git a/pcsx2/GS/RrvOriginalPresentation.h b/pcsx2/GS/RrvOriginalPresentation.h
new file mode 100644
--- /dev/null
+++ b/pcsx2/GS/RrvOriginalPresentation.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace rrv::original_present {
+struct Plan {uint64_t field=0,source=0;uint32_t present=1,fields=1;};
+class PlanLatch {
+ bool pending_=false;
+ Plan plan_{};
+public:
+ bool arm(uint64_t field,uint64_t current,uint64_t source,uint32_t present,uint32_t fields,bool full) {
+  if(pending_ || !field || field<=current || present>1 || (fields!=1 && fields!=2) ||
+     (fields==2 && !full) || (fields==1 && !present))return false;
+  plan_={field,source,present,fields};pending_=true;return true;
+ }
+ bool matches(uint64_t field)const{return !pending_ || plan_.field==field;}
+ bool take(uint64_t field,Plan& value,bool& active) {
+  if(!matches(field))return false;
+  active=pending_;value=pending_?plan_:Plan{};pending_=false;return true;
+ }
+};
+// GS-owner-only, within the bridge DSO. No guest/MMIO or simulation state.
+class Gate {
+ int decision_=-1;
+ uint32_t fields_=1;
+public:
+ bool set(int decision,uint32_t fields) {
+  if(decision < -1 || decision > 1 || (fields!=1 && fields!=2) ||
+     (fields==1 && decision==0) || (decision==-1 && fields!=1)) {
+   decision_=-1;fields_=1;return false;
+  }
+  decision_=decision;fields_=fields;return true;
+ }
+ int consume() {int result=decision_;decision_=-1;return result;}
+ uint32_t fields() const {return fields_;}
+};
+inline Gate& gate() {static Gate value;return value;}
+
+class TargetGrid {
+ bool have_=false;
+ uint32_t fields_=1;
+ double target_=0;
+public:
+ static constexpr double base_period=1001.0/60000.0;
+ double plan(double now,double margin,double creep,uint32_t fields,uint64_t& late,uint64_t& reanchors) {
+  if(fields!=1 && fields!=2)fields=1;
+  const double earliest=now+margin;
+  const double period=base_period*fields;
+  if(fields!=fields_) {
+   fields_=fields;
+   if(have_) {
+    ++reanchors;
+    // Do not schedule a newer source image before a previously queued image.
+    target_=std::max(earliest,target_+1e-6);
+    return target_;
+   }
+  }
+  if(!have_) {have_=true;target_=earliest;return target_;}
+  const double next=target_+period;
+  if(earliest>next+2.0*period || next>earliest+2.0*period) {
+   ++reanchors;target_=earliest;
+  } else if(earliest>next) {
+   ++late;target_=earliest;
+  } else target_=std::max(earliest,next-creep);
+  return target_;
+ }
+};
+} // namespace rrv::original_present
