index 0000000..09127a8
--- /dev/null
+++ b/3rdparty/rrv-ios-pcap/include/pcap.h
@@ -0,0 +1,36 @@
+/* RRV iOS bridge: minimal libpcap interface; every call fails (pcap_stub.c). */
+#pragma once
+#include <stdint.h>
+#include <sys/time.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define PCAP_ERRBUF_SIZE 256
+#define PCAP_NETMASK_UNKNOWN 0xffffffffu
+#define DLT_EN10MB 1
+#define DLT_IEEE802_11 105
+typedef struct pcap pcap_t;
+typedef struct pcap_dumper pcap_dumper_t;
+struct pcap_pkthdr { struct timeval ts; uint32_t caplen; uint32_t len; };
+struct bpf_insn { unsigned short code; unsigned char jt, jf; uint32_t k; };
+struct bpf_program { unsigned int bf_len; struct bpf_insn* bf_insns; };
+typedef struct pcap_addr pcap_addr_t;
+struct pcap_addr { struct pcap_addr* next; struct sockaddr* addr; struct sockaddr* netmask; struct sockaddr* broadaddr; struct sockaddr* dstaddr; };
+typedef struct pcap_if pcap_if_t;
+struct pcap_if { struct pcap_if* next; char* name; char* description; struct pcap_addr* addresses; uint32_t flags; };
+pcap_t* pcap_open_live(const char*, int, int, int, char*);
+void pcap_close(pcap_t*);
+int pcap_compile(pcap_t*, struct bpf_program*, const char*, int, uint32_t);
+void pcap_freecode(struct bpf_program*);
+int pcap_setfilter(pcap_t*, struct bpf_program*);
+int pcap_setnonblock(pcap_t*, int, char*);
+int pcap_datalink(pcap_t*);
+const char* pcap_datalink_val_to_name(int);
+char* pcap_geterr(pcap_t*);
+int pcap_next_ex(pcap_t*, struct pcap_pkthdr**, const unsigned char**);
+int pcap_sendpacket(pcap_t*, const unsigned char*, int);
+int pcap_findalldevs(pcap_if_t**, char*);
+void pcap_freealldevs(pcap_if_t*);
+#ifdef __cplusplus
+}
+#endif
diff --git a/3rdparty/rrv-ios-pcap/pcap_stub.c b/3rdparty/rrv-ios-pcap/pcap_stub.c
new file mode 100644
index 0000000..0d670c9
--- /dev/null
+++ b/3rdparty/rrv-ios-pcap/pcap_stub.c
@@ -0,0 +1,18 @@
+/* RRV iOS bridge: libpcap stand-in. No capture devices exist; every call fails. */
+#include <pcap.h>
+#include <string.h>
+static char s_error[] = "packet capture is not available on iOS";
+static void fill(char* errbuf) { if (errbuf) { strncpy(errbuf, s_error, PCAP_ERRBUF_SIZE - 1); errbuf[PCAP_ERRBUF_SIZE - 1] = 0; } }
+pcap_t* pcap_open_live(const char* d, int s, int p, int t, char* e) { (void)d; (void)s; (void)p; (void)t; fill(e); return 0; }
+void pcap_close(pcap_t* p) { (void)p; }
+int pcap_compile(pcap_t* p, struct bpf_program* b, const char* s, int o, uint32_t m) { (void)p; (void)b; (void)s; (void)o; (void)m; return -1; }
+void pcap_freecode(struct bpf_program* b) { (void)b; }
+int pcap_setfilter(pcap_t* p, struct bpf_program* b) { (void)p; (void)b; return -1; }
+int pcap_setnonblock(pcap_t* p, int n, char* e) { (void)p; (void)n; fill(e); return -1; }
+int pcap_datalink(pcap_t* p) { (void)p; return -1; }
+const char* pcap_datalink_val_to_name(int v) { (void)v; return 0; }
+char* pcap_geterr(pcap_t* p) { (void)p; return s_error; }
+int pcap_next_ex(pcap_t* p, struct pcap_pkthdr** h, const unsigned char** d) { (void)p; (void)h; (void)d; return -1; }
+int pcap_sendpacket(pcap_t* p, const unsigned char* d, int n) { (void)p; (void)d; (void)n; return -1; }
+int pcap_findalldevs(pcap_if_t** a, char* e) { if (a) *a = 0; fill(e); return -1; }
+void pcap_freealldevs(pcap_if_t* a) { (void)a; }
