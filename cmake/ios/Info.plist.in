<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Magatama</string>
	<key>CFBundleExecutable</key><string>Magatama</string>
	<key>CFBundleIdentifier</key><string>io.github.bittahbandit1.magatama</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>Magatama</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>0.1</string>
	<key>CFBundleVersion</key><string>${MAGATAMA_IOS_BUILD}</string>
	<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
	<key>MinimumOSVersion</key><string>${MAGATAMA_IOS_MIN_OS}</string>
	<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string><string>metal</string></array>
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
	<key>UIRequiresFullScreen</key><true/>
	<key>UIStatusBarHidden</key><true/>
	<key>UIViewControllerBasedStatusBarAppearance</key><false/>
	<!-- RULE: Magatama runs landscape only on iPhone and iPad (CONTRIBUTING.md, "Hard rules"). Both lists hold only
	     the two landscape orientations; scripts/magatama_build_ios.sh fails the build if either allows portrait. -->
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>UILaunchScreen</key><dict><key>UIColorName</key><string></string></dict>
	<key>GCSupportsControllerUserInteraction</key><true/>
	<key>GCSupportedGameControllers</key>
	<array><dict><key>ProfileName</key><string>ExtendedGamepad</string></dict></array>
	<key>UIApplicationSupportsIndirectInputEvents</key><true/>
	<key>CADisableMinimumFrameDurationOnPhone</key><true/>
</dict>
</plist>
