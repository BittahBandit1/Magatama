 	SetTCOffset();
 }
 
+float GSRendererHW::s_rrv_scene_scale = 0.0f;
+
+void GSRrvSetSceneScale(float scale)
+{
+	// Exactly 1 would take the texture cache's native-downscale paths (integer box filter, m_downscaled).
+	GSRendererHW::s_rrv_scene_scale = scale <= 0.0f ? 0.0f : std::max(scale, 1.0001f);
+}
+
 void GSRendererHW::VSync(u32 field, bool registers_written, bool idle_frame)
 {
+	m_rrv_in_scene = false;
 	if (GSConfig.LoadTextureReplacements)
 		GSTextureReplacements::ProcessAsyncLoadedTextures();
 
@@ -3828,6 +3837,22 @@ void GSRendererHW::Draw()
 		target_scale = src->m_from_target->GetScale();
 	}
 
+	// RRV (GSRrvSetSceneScale): the 3D at the scene scale, the 2D over it at the configured scale.
+	if (s_rrv_scene_scale > 0.0f && target_scale == GetTextureScaleFactor() && !IsPossibleChannelShuffle() && !m_downscale_source)
+	{
+		// Nocturne draws its dialogue band, text and menus as sprites at one depth at the far end of the range
+		// (Z=0xfffff0, ZTST GEQUAL): depth-tested, but a flat 2D layer, so they stay at the HUD's scale.
+		const bool flat_2d = m_vt.m_primclass == GS_SPRITE_CLASS && m_vt.m_min.p.z == m_vt.m_max.p.z &&
+			m_vt.m_max.p.z >= 16773120.0f; // 0xFFF000
+		const bool depth = !flat_2d && (m_cached_ctx.DepthWrite() || (m_cached_ctx.TEST.ZTE && m_cached_ctx.TEST.ZTST > ZTST_ALWAYS));
+		if (depth)
+			m_rrv_in_scene = true;
+		else if (m_vt.m_primclass == GS_SPRITE_CLASS)
+			m_rrv_in_scene = false;
+		if (m_rrv_in_scene)
+			target_scale = s_rrv_scene_scale;
+	}
